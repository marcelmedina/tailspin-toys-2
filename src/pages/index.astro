---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-8">
        <h2 class="text-2xl font-medium mb-4 text-slate-100">Find a game</h2>
        <form action="/" method="get" class="grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-5 md:grid-cols-[1fr_16rem_auto] md:items-end" data-testid="game-filters">
          <fieldset>
            <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-300 transition-colors hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="accent-blue-500"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
            <select id="publisher-filter" name="publisher" class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" data-testid="publisher-filter">
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>

          <button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" data-testid="apply-filters">
            Apply filters
          </button>
        </form>
      </div>

      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
        <div hidden data-testid="filtered-empty-state">
          <EmptyState text="No games match the selected filters." />
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];

  if (form) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    const selectedPublisher = params.get('publisher') ?? '';

    form.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');
    if (publisherInput) publisherInput.value = selectedPublisher;

    cards.forEach((card) => {
      const matchesCategory =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const matchesPublisher =
        selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      card.hidden = !(matchesCategory && matchesPublisher);
    });

    const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
    if (emptyState) emptyState.hidden = cards.every((card) => card.hidden);
  }
</script>
